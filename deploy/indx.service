[Unit]
Description=Indx identity card
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/indx
Environment=INDX_BASE=/indx/
ExecStart=/usr/bin/php -S 127.0.0.1:8095 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/indx
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
